# Google Workspace Gmail SMTP Email Configuration (used only by /api/send-enquiry on the server)
# Requires 2-Step Verification enabled on the Google Workspace account to generate an App Password
# SMTP_USER and SMTP_PASS are required; the rest fall back to the defaults shown here.
# Never commit real values: copy this file to .env.local and set the same variables in Vercel.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="drakshayani@vmsquaresecurity.com"
SMTP_PASS="your_16_char_google_app_password"

# Official Recipient Inbox (All website enquiries and quotes will arrive here)
CONTACT_TO_EMAIL="drakshayani@vmsquaresecurity.com"

# Verified Sender Address
CONTACT_FROM_EMAIL="\"VM SQUARE Website\" <drakshayani@vmsquaresecurity.com>"
